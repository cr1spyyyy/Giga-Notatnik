<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Główna definicja motywu aplikacji -->
    <style name="Theme.GigaNotatnik" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorSecondary">@color/primary_teal_light</item>
        <item name="colorOnPrimary">@color/text_on_button_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
    </style>

    <style name="Theme.GigaNotatnik.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_teal_dark</item>
        <item name="colorOnPrimary">@color/text_on_button_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
    </style>

    <!-- Styl dla przycisków -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <!-- używaj drawable jako tła -->
        <item name="android:background">@drawable/button_background</item>
        <!-- tekst pobiera kolor z motywu -->
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Styl dla EditText -->
    <style name="AppEditText" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorPrimary</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/edittext_background</item>
    </style>

    <!-- Styl dla SearchView -->
    <style name="AppSearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:queryHint">@string/search_notes</item>
        <item name="android:iconifiedByDefault">false</item>
        <item name="android:textColorHint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:background">@drawable/edittext_background</item>
    </style>

</resources>
