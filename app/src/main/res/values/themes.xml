<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Adaptacyjny motyw aplikacji -->
    <style name="Theme.GigaNotatnik" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/statusBarColor</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorSecondary">@color/primary_teal</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorOnPrimary">@color/text_on_button</item>

    </style>

    <!-- Styl dla przycisków -->
    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="NoteActionButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:backgroundTint">@color/note_button_background</item>
        <item name="android:textColor">@color/note_button_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Styl dla EditText -->
    <style name="AppEditText" parent="Widget.MaterialComponents.TextInputEditText.FilledBox">
        <item name="android:textColor">@color/search_text_black</item>
        <item name="android:textColorHint">?attr/colorPrimary</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/edittext_background</item>
    </style>

    <!-- Styl dla SearchView -->
    <style name="AppSearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:queryHint">@string/search_notes</item>
        <item name="android:iconifiedByDefault">false</item>
        <item name="android:textColor">@color/search_text_black</item>
        <item name="android:textColorHint">?attr/colorPrimary</item>
        <item name="android:background">@drawable/edittext_background</item>
    </style>

</resources>
